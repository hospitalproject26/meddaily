{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ufwfydcynlxnlmswzrld.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "smart-pharmacy-manager",
      "version": "0.1.0",
      "title": "Smart Pharmacy Manager"
    },
    "tools": [
      {
        "name": "search_inventory",
        "title": "Search inventory",
        "description": "Search the pharmacy's medicine inventory by name, with optional category filter. Returns stock, batch, expiry and pricing.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Part of the medicine name to search for.",
              "type": "string"
            },
            "category": {
              "description": "Medicine category filter.",
              "type": "string",
              "enum": [
                "GM",
                "SM",
                "GI"
              ]
            },
            "limit": {
              "description": "Maximum rows to return (default 25, max 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "stock_alerts",
        "title": "Stock and expiry alerts",
        "description": "List medicines that are low on stock or expiring soon, so the pharmacy can reorder or clear them.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "low_stock_threshold": {
              "description": "Remaining stock at or below this counts as low (default 10).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "expiring_within_days": {
              "description": "Flag items expiring within this many days (default 90).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "sales_summary",
        "title": "Sales summary",
        "description": "Summarise sales for a date range: invoice count, revenue, discount, GST and profit, plus the most recent invoices.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "from": {
              "description": "Start date, YYYY-MM-DD. Defaults to 30 days ago.",
              "type": "string"
            },
            "to": {
              "description": "End date, YYYY-MM-DD. Defaults to today.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_invoice",
        "title": "Get invoice details",
        "description": "Fetch one sales invoice with all of its line items, by invoice number or order id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "invoice_number": {
              "description": "The invoice number shown on the bill.",
              "type": "string"
            },
            "order_id": {
              "description": "The internal order id (UUID).",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_customers",
        "title": "Search customers",
        "description": "Search pharmacy customers by name or phone number. Returns contact details, regular medicines and next refill date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Part of a customer name or phone number.",
              "type": "string"
            },
            "refill_due_before": {
              "description": "Only customers with a next refill date on or before this YYYY-MM-DD date.",
              "type": "string"
            },
            "limit": {
              "description": "Maximum rows to return (default 25, max 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_distributors",
        "title": "List distributors",
        "description": "List the pharmacy's distributors with contact details and the medicines they supply.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Part of a distributor name to filter by.",
              "type": "string"
            },
            "limit": {
              "description": "Maximum rows to return (default 50, max 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
